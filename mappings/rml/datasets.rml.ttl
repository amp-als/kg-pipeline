################################################################################
# ALS KP — RML mapping: Datasets (syn66496326)
# Source CSV: data/csv/datasets.csv
# Output: data/rdf/datasets.ttl
#
# IRI scheme: https://www.synapse.org/Synapse:{id}
# Prefix: alskp: <https://alskp.synapse.org/terms#>
################################################################################

@prefix rr:    <http://www.w3.org/ns/r2rml#> .
@prefix rml:   <http://semweb.mmlab.be/ns/rml#> .
@prefix fnml:  <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno:   <https://w3id.org/function/ontology#> .
@prefix ql:    <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix grel:  <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix alskp: <https://alskp.synapse.org/terms#> .
@prefix biolink: <https://w3id.org/biolink/vocab/> .
@prefix map:   <https://alskp.synapse.org/mappings/datasets#> .

################################################################################
# Shared logical source
################################################################################

map:DatasetsSource a rml:LogicalSource ;
    rml:source "data/csv/datasets.csv" ;
    rml:referenceFormulation ql:CSV .

################################################################################
# Core facts
################################################################################

map:DatasetCore a rr:TriplesMap ;
    rdfs:label "Dataset Core" ;
    rml:logicalSource map:DatasetsSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{id}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ;
        rr:objectMap [ rr:constant alskp:Dataset ; rr:termType rr:IRI ] ] ;
    # Materialized superclass: alskp:Dataset rdfs:subClassOf biolink:Dataset in
    # schema/ontology.ttl, but GraphDB runs without reasoning, so the inferred
    # type is asserted here instead of derived at query time.
    rr:predicateObjectMap [ rr:predicate rdf:type ;
        rr:objectMap [ rr:constant biolink:Dataset ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:name ;
        rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:description ;
        rr:objectMap [ rml:reference "description" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:dataType ;
        rr:objectMap [ rml:reference "dataType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:dataSubtype ;
        rr:objectMap [ rml:reference "dataSubtype" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:species ;
        rr:objectMap [ rml:reference "species" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:biospecimenSubtype ;
        rr:objectMap [ rml:reference "biospecimenSubtype" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:studyType ;
        rr:objectMap [ rml:reference "studyType" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:source ;
        rr:objectMap [ rml:reference "source" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:sameAs ;
        rr:objectMap [ rml:reference "sameAs" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:geoSuperSeriesId ;
        rr:objectMap [ rml:reference "GEOSuperSeries" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:url ;
        rr:objectMap [ rml:reference "url" ; rr:datatype xsd:anyURI ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:collection ;
        rr:objectMap [ rml:reference "collection" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:acknowledgementStatement ;
        rr:objectMap [ rml:reference "acknowledgementStatement" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:portalRelease ;
        rr:objectMap [ rml:reference "portalRelease" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:individualCount ;
        rr:objectMap [ rml:reference "individualCount" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:duoCodes ;
        rr:objectMap [ rml:reference "duoCodes" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:datasetCode ;
        rr:objectMap [ rml:reference "datasetCode" ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate alskp:subject ;
        rr:objectMap [ rml:reference "subject" ; rr:datatype xsd:string ] ] .

################################################################################
# Numeric property: participantCount
################################################################################

map:DatasetParticipantCount a rr:TriplesMap ;
    rdfs:label "Dataset Participant Count" ;
    rml:logicalSource map:DatasetsSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{id}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate alskp:participantCount ;
        rr:objectMap [ rml:reference "participantCount" ; rr:datatype xsd:integer ] ] .

################################################################################
# Multi-value: disease
################################################################################

map:DatasetDisease a rr:TriplesMap ;
    rdfs:label "Dataset Disease (multi-value)" ;
    rml:logicalSource map:DatasetsSource ;
    rr:subjectMap [ rr:template "https://www.synapse.org/Synapse:{id}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [
        rr:predicate alskp:disease ;
        rr:objectMap [
            a fnml:FunctionTermMap ;
            rr:datatype xsd:string ;
            fnml:functionValue [
                a fno:Execution ;
                rml:logicalSource map:DatasetsSource ;
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_split ; rr:termType rr:IRI ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rml:reference "disease" ; rr:termType rr:Literal ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_sep ;
                    rr:objectMap [ rr:constant "\\|" ; rr:termType rr:Literal ]
                ]
            ]
        ]
    ] .

